#include <WiFi.h>

const char* ssid     = "Josh"; // <-- Change this
const char* password = "Josh2004"; // <-- Change this

WiFiServer server(80);
const int ledPin = 2; // The blue LED on your board

void setup() {
  Serial.begin(115200);
  pinMode(ledPin, OUTPUT);

  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("WiFi connected.");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP()); // This is the address you will visit
  server.begin();
}

void loop() {
  WiFiClient client = server.available();

  if (client) {
    Serial.println("New Client.");
    String currentLine = "";
    while (client.connected()) {
      if (client.available()) {
        char c = client.read();
        if (c == '\n') {
          if (currentLine.length() == 0) {
            // Send HTTP headers
            client.println("HTTP/1.1 200 OK");
            client.println("Content-type:text/html");
            client.println();
            // Build the HTML page
            client.print("<h1>ESP32 Control</h1>");
            client.print("<p><a href=\"/H\"><button style='font-size:30px'>TURN ON</button></a></p>");
            client.print("<p><a href=\"/L\"><button style='font-size:30px'>TURN OFF</button></a></p>");
            client.println();
            break;
          } else {
            currentLine = "";
          }
        } else if (c != '\r') {
          currentLine += c;
        }

        // Check the client request
        if (currentLine.endsWith("GET /H")) digitalWrite(ledPin, HIGH);
        if (currentLine.endsWith("GET /L")) digitalWrite(ledPin, LOW);
      }
    }
    client.stop();
    Serial.println("Client Disconnected.");
  }
}
